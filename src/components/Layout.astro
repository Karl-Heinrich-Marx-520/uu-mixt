---
/**
 * Layout.astro —— 共享外壳（[共享外壳]）
 * 结构（与 demo 逐层一致）：
 *   body[data-face] → .page-bg / .page-veil（仅面页）→ .page-card（页头/内容/页脚）
 * Props:
 *   face: "uu" | "mixt" | "shared"
 *   flipTo?: string          —— 翻面目标路径（面页传对方面；共享页不传）
 *   hasHero?: boolean        —— 是否挂载常驻虚化背景层（面首页）
 *   title / description
 */
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/shell.css";
import "../styles/components.css";
import "../styles/face.css";
import "../styles/article.css";
import "../styles/pet.css";
import ThemeBoot from "./ThemeBoot.astro";

interface Props {
  face: "uu" | "mixt" | "shared";
  flipTo?: string;
  hasHero?: boolean;
  title: string;
  description?: string;
  defaultMode?: "light" | "dark";
  /** 额外的页级脚本（如文章页的 article-share / article-code / article-view / reading） */
  scripts?: string[];
  /** 页面主体是否自带 .page 容器（文章页用 .article-page） */
  bodyClass?: string;
  /** 社交分享图（相对/绝对均可）。不传则回退 /og-default.jpg */
  ogImage?: string;
  /** og:type —— 内容页传 "article"，其余默认 "website" */
  ogType?: "website" | "article";
  /** 文章发布时间（ISO 字符串），ogType="article" 时输出 */
  publishedTime?: string;
  /** 覆盖 canonical 路径；默认取当前路径 */
  canonical?: string;
  /** 管理入口与空壳页（如搜索页）传 true，避免被搜索引擎收录 */
  noindex?: boolean;
}

const {
  face,
  flipTo,
  hasHero = false,
  title,
  description = "",
  defaultMode = "dark",
  scripts = [],
  bodyClass = "",
  ogImage,
  ogType = "website",
  publishedTime,
  canonical,
  noindex = false,
} = Astro.props;
const otherFace = face === "uu" ? "mixt" : "uu";
const bodyClasses = [hasHero ? "has-hero" : "", bodyClass].filter(Boolean).join(" ");

/* 社交分享与规范链接：全部用绝对地址（分享抓取器不解析相对路径）。
   站点根取 astro.config.mjs 的 site，兜底写死域名。 */
const SITE_ROOT = (Astro.site?.href || "https://uuandmixt.com/").replace(/\/$/, "");
const canonicalURL = new URL(canonical || Astro.url.pathname, SITE_ROOT).href;
const ogImageURL = new URL(ogImage || "/og-default.jpg", SITE_ROOT).href;
---
<!DOCTYPE html>
<html lang="zh-CN" data-mode={defaultMode} data-default-mode={defaultMode}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  {/* 明暗模式引导：抽成 ThemeBoot 组件，入口页共用同一份（入口页不走 Layout，
      以前两处各写一份，改起来必漏一处） */}
  <ThemeBoot />
  <link rel="icon" type="image/png" href="/favicon.png?v=1">
  {description && <meta name="description" content={description}>}
  {noindex && <meta name="robots" content="noindex, follow">}
  {/* 规范链接：避免带/不带尾斜杠被搜索引擎算作重复页（trailingSlash: always） */}
  <link rel="canonical" href={canonicalURL}>
  {/* 社交分享卡片（微信 / QQ / Twitter / Discord 抓取用）。此前全站缺失，
      分享出去只有一条光秃链接，没有任何标题与缩略图 */}
  <meta property="og:type" content={ogType}>
  <meta property="og:site_name" content="UU&Mixt">
  <meta property="og:locale" content="zh_CN">
  <meta property="og:title" content={title}>
  {description && <meta property="og:description" content={description}>}
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:image" content={ogImageURL}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {ogType === "article" && publishedTime && (
    <meta property="article:published_time" content={publishedTime}>
  )}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  {description && <meta name="twitter:description" content={description}>}
  <meta name="twitter:image" content={ogImageURL}>
  {hasHero && <link rel="preload" as="image" href={`/assets/bg/bg-${face}.jpg`}>}
  {/* RSS 自动发现（PRD 5.4）：面页给该面的 feed，共享页给全站合流 feed */}
  <link
    rel="alternate"
    type="application/rss+xml"
    title={face === "uu" ? "UU&Mixt · UU 的一面" : face === "mixt" ? "UU&Mixt · Mixt 的一面" : "UU&Mixt · 全部文章"}
    href={face === "uu" ? "/uu/rss.xml" : face === "mixt" ? "/mixt/rss.xml" : "/rss.xml"}
  />
  <script is:inline>
    /* 翻入预备：防闪帧（demo 同款，demo.js 接管后移除） */
    try {
      if (sessionStorage.getItem("uum-flip-in") === "1") {
        document.documentElement.classList.add("flip-in-pending");
        setTimeout(function () {
          document.documentElement.classList.remove("flip-in-pending");
        }, 1500);
      }
    } catch (e) {}
  </script>
</head>
<body data-face={face} data-flip-to={flipTo} class={bodyClasses || undefined}>

  <a class="skip-link" href="#main">跳到正文</a>

  {hasHero && (
    <Fragment>
      <div class="page-bg-clip" aria-hidden="true">
        <div class="page-bg"></div>
        <div class="page-veil"></div>
      </div>
    </Fragment>
  )}

  <div class="page-card">

  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/" title="回到入口页">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 12a8 8 0 0 1 13-6.2M20 12a8 8 0 0 1-13 6.2"/>
            <path d="M17 3v3.5h-3.5M7 21v-3.5h3.5"/>
          </svg>
        </span>
        UU<span class="amp">&amp;</span>Mixt
      </a>
      <nav class="nav" aria-label="面导航">
        <slot name="nav" />
      </nav>
      <div class="header-actions">
        <a class="icon-btn" href="/search/" aria-label="全站搜索" title="全站搜索：一次搜索覆盖两面">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        </a>
        <button class="icon-btn" data-action="toggle-mode" aria-label="切换明暗模式" title="切换明暗模式">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        {flipTo && (
          <a class="flip-btn" href={flipTo} data-action="flip" aria-label={`翻到 ${otherFace === "uu" ? "UU" : "Mixt"} 的一面`} title={`翻到 ${otherFace === "uu" ? "UU" : "Mixt"} 的一面（Alt + ←/→）`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 12a8 8 0 0 1 13-6.2M20 12a8 8 0 0 1-13 6.2"/>
              <path d="M17 3v3.5h-3.5M7 21v-3.5h3.5"/>
            </svg>
            <span class="flip-text">翻到 {otherFace === "uu" ? "UU" : "Mixt"}</span>
          </a>
        )}
      </div>
    </div>
  </header>

  <main class={hasHero ? undefined : "page"} id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">UU<span class="amp">&amp;</span>Mixt</div>
      <nav class="footer-links" aria-label="站点级链接">
        {face !== "shared" && (
          <Fragment>
            <a href={`/${face}/tags/`}>标签</a>
            <span class="sep">·</span>
          </Fragment>
        )}
        <a href={face === "uu" ? "/uu/rss.xml" : face === "mixt" ? "/mixt/rss.xml" : "/rss.xml"}>RSS</a>
        <span class="sep">·</span>
        <a href="/search/">全站搜索</a>
        <span class="sep">·</span>
        <a href="/about/">关于本站</a>
        <span class="sep">·</span>
        <a href="/stats/">站点数据</a>
        <span class="sep">·</span>
        <a href="/admin/">写作台</a>
      </nav>
      <p class="icp"><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">湘ICP备2026041717号-1</a></p>
      <p>
        {face === "shared"
          ? "UU&Mixt · 双作者双面技术博客"
          : `${face === "uu" ? "UU" : "Mixt"} 的一面 · 由 ${face === "uu" ? "UU" : "Mixt"} 独立维护`}
      </p>
    </div>
  </footer>

  </div><!-- /.page-card -->

  <button class="back-top" data-action="back-top" aria-label="回到顶部" title="回到顶部">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
  </button>

  <script is:inline src="/scripts/core.js"></script>
  {/* flip.js 只在需要翻面的页面加载：它管的是卡牌翻转的翻出/翻入与触屏滑动，
      而 /stats/ /search/ /about/ 这类共享页根本没有 flipTo，加载它就是白下载 */}
  {flipTo && <script is:inline src="/scripts/flip.js"></script>}
  {/* 页级脚本一律 defer：文章页拆成 4 个脚本后，同步加载会各自阻塞一次解析。
      defer 保证 DOM 解析完再按顺序执行，对这几个脚本（都依赖 DOM）语义一致。 */}
  {scripts.map((src) => <script is:inline src={src} defer></script>)}
  <!-- 站点鼠标样式图集 + 藤蔓点击效果（demo 定稿 2026-09-22）：非关键路径，defer 加载 -->
  <script is:inline src="/scripts/cursors.js?v=1" defer></script>
  <script is:inline src="/scripts/vine.js?v=1" defer></script>
  <!-- 桌宠小鹿（PRD E1）：全站最大的脚本（33KB / gzip 13.6KB），原本 defer 仍会在
       首屏阶段下载并解析。改成 window load 之后再注入——桌宠本就不该和正文抢带宽。 -->
  <script is:inline>
    window.addEventListener("load", function () {
      var s = document.createElement("script");
      s.src = "/scripts/pet.js?v=3";
      document.body.appendChild(s);
    });
  </script>
</body>
</html>

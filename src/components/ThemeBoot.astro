---
/**
 * ThemeBoot —— 明暗模式引导脚本（共享外壳）
 *
 * 为什么单独成一个组件：入口页（index.astro）不走 Layout、head 是手写的，
 * 两处各写一份同样的内联脚本必然会在某次改动后漏同步（本项目已踩过这类坑）。
 * 抽成组件后，Layout 与入口页都只写一行 <ThemeBoot />。
 *
 * 为什么必须内联且必须在 CSS 之前：core.js 挂在 body 末尾，等它读到 localStorage
 * 时首帧已经按默认色画完，浅色用户会看到「深色闪一下再变」。
 *
 * 取值优先级：用户显式选择 > 页面的 data-mode-lock（写作台写死自己的主题）
 * > 系统 prefers-color-scheme > 兜底 dark。
 */
---
<script is:inline>
  (function () {
    try {
      var saved = localStorage.getItem("uum-mode");
      var lock = document.documentElement.dataset.modeLock || "";
      var prefersLight = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches;
      var mode = saved || lock || (prefersLight ? "light" : "dark");
      document.documentElement.setAttribute("data-mode", mode);
      /* 移动端浏览器地址栏跟着走（取值对应 tokens.css 的 --bg） */
      var meta = document.createElement("meta");
      meta.name = "theme-color";
      meta.content = mode === "light" ? "#f5f6f8" : "#0d121d";
      document.head.appendChild(meta);
    } catch (e) {}
  })();
</script>

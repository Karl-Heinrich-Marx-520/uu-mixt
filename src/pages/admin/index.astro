---
/**
 * 写作台登录门（/admin/，[写作台]）
 * 后端选型 B：作者粘贴各自 fine-grained PAT（Contents: Read and write，仅本仓库）。
 * 身份由 GET /user 判定 → 映射到 uu / mixt；未授权账号拒绝进入。
 */
import "../../styles/tokens.css";
import "../../styles/base.css";
import "../../styles/shell.css";
import "../../styles/admin.css";
---
<!DOCTYPE html>
<html lang="zh-CN" data-mode="dark" data-default-mode="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>登录 · 写作台 · UU&amp;Mixt</title>
  <meta name="description" content="UU&Mixt 写作台登录：两位作者各自使用自己的 GitHub 凭据进入本人工作台。">
  <meta name="robots" content="noindex">
</head>
<body data-face="shared" data-page="admin">

  <div class="page-card">

  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/" title="回到入口页">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 12a8 8 0 0 1 13-6.2M20 12a8 8 0 0 1-13 6.2"/>
            <path d="M17 3v3.5h-3.5M7 21v-3.5h3.5"/>
          </svg>
        </span>
        UU<span class="amp">&amp;</span>Mixt <span class="admin-badge">写作台</span>
      </a>
      <nav class="nav" aria-label="站点级导航">
        <a href="/">入口页</a>
        <a href="/uu/">UU 的一面</a>
        <a href="/mixt/">Mixt 的一面</a>
      </nav>
      <div class="header-actions">
        <button class="icon-btn" data-action="toggle-mode" aria-label="切换明暗模式" title="切换明暗模式">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main class="page admin-shell login-page" id="main">
    <section class="login-wrap">
      <form class="login-card" data-login-form>
        <h1>登录写作台</h1>
        <p class="sub">用你自己的凭据登录，进入后只能管理自己那一面的文章与分类。</p>

        <label for="login-token">GitHub 凭据（Fine-grained PAT）</label>
        <input id="login-token" type="password" autocomplete="off" placeholder="github_pat_..." data-login-input>
        <button class="login-btn" type="submit">进入写作台</button>
        <p class="login-error" data-login-error role="alert"></p>

        <div class="login-hint">
          <b>UU（仓库所有者）· 用 Fine-grained token</b><br>
          Settings → Developer settings → <b>Fine-grained tokens</b> → Generate new token<br>
          Resource owner = 你自己 · Repository access 只选 <code>uu-mixt</code> ·
          Permissions → <code>Contents: Read and write</code><br>
          <br>
          <b>Mixt（仓库协作者）· 只能用 Classic token</b><br>
          Settings → Developer settings → <b>Tokens (classic)</b> → Generate new token →
          勾选 <code>repo</code><br>
          原因：GitHub 官方限制——fine-grained token 不支持"仓库协作者"身份
          （见 Fine-grained PAT limitations）。代价：classic token 会覆盖你名下所有仓库，
          请设置过期时间并妥善保管。<br>
          <br>
          凭据只存在你自己的浏览器，不进仓库、不进构建产物。<br>
          自测：在地址后加 <code>?mock=1</code> 可用内存假后端走通全流程。
        </div>
      </form>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">UU<span class="amp">&amp;</span>Mixt</div>
      <nav class="footer-links" aria-label="站点级链接">
        <a href="/about/">关于本站</a>
      </nav>
      <p>UU&amp;Mixt 写作台 · 提交即发布（无审核环节）</p>
    </div>
  </footer>

  </div><!-- /.page-card -->

  <script is:inline src="/scripts/core.js"></script>
  <script is:inline src="/scripts/admin/gh.js"></script>
  <script>
    (function () {
      "use strict";
      var form = document.querySelector("[data-login-form]");
      var input = document.getElementById("login-token");
      var errBox = document.querySelector("[data-login-error]");

      /* 已登录 → 直接进工作台 */
      var s = window.UUMGH.getSession();
      if (s && s.face) { location.replace("/admin/desk/"); return; }

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        var token = input.value.trim();
        if (!token) { errBox.textContent = "请先粘贴凭据。"; return; }
        errBox.textContent = "正在校验身份…";
        window.UUMGH.verifyToken(token).then(function (r) {
          if (!r.face) {
            errBox.textContent = "账号 " + r.login + " 未获授权（只有 UU 与 Mixt 两位作者可进入写作台）。";
            return;
          }
          window.UUMGH.setSession({ face: r.face, login: r.login, token: token });
          location.href = "/admin/desk/";
        }).catch(function (err) {
          errBox.textContent = err.message;
        });
      });
    })();
  </script>
</body>
</html>

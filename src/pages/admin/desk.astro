---
/**
 * 写作台工作台（/admin/desk/，[写作台]）
 * 交互与 demo/admin-desk.html 一致：文章（状态与操作合并列）/ 分类（自维护 + 时间线）/ 媒体（真实上传 + 引用生成）。
 * 面由会话推导，接口不接受 face 参数（技术强制只管自己那一面）。
 */
import "../../styles/tokens.css";
import "../../styles/base.css";
import "../../styles/shell.css";
import "../../styles/components.css";
import "../../styles/admin.css";
---
<!DOCTYPE html>
<html lang="zh-CN" data-mode="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>工作台 · 写作台 · UU&amp;Mixt</title>
  <meta name="robots" content="noindex">
</head>
<body data-face="shared" data-page="admin">

  <div class="page-card">

  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/" title="回到入口页">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 12a8 8 0 0 1 13-6.2M20 12a8 8 0 0 1-13 6.2"/>
            <path d="M17 3v3.5h-3.5M7 21v-3.5h3.5"/>
          </svg>
        </span>
        UU<span class="amp">&amp;</span>Mixt <span class="admin-badge">写作台</span>
      </a>
      <nav class="nav" aria-label="写作台导航">
        <a href="#" data-face-home>我的一面</a>
        <a href="/">入口页</a>
        <a href="/about/">关于本站</a>
      </nav>
      <div class="header-actions">
        <button class="icon-btn" data-action="toggle-mode" aria-label="切换明暗模式" title="切换明暗模式">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main class="page admin-shell" id="main">
    <div class="admin-user">
      <img data-user-avatar src="/assets/avatars/uu.jpg" alt="">
      <div>
        <b data-user-name>—</b>
        <span data-user-role>—</span>
      </div>
      <button class="admin-logout" type="button" data-action="logout">登出</button>
    </div>

    <div class="notice notice--info">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M12 12v4"/></svg>
      <span><strong>保存即提交进仓库，没有审核环节。</strong>非草稿的文章在仓库更新后由部署方构建上线。文章的链接地址（URL 短名）由系统按标题自动生成，界面上不提供填写项。</span>
    </div>

    <div class="admin-layout">
      <aside class="admin-side" aria-label="写作台菜单">
        <button class="admin-side-item is-active" type="button" data-panel="posts">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
          文章
        </button>
        <button class="admin-side-item" type="button" data-panel="categories">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          分类
        </button>
        <button class="admin-side-item" type="button" data-panel="tagpool">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.24H4a2 2 0 0 0-2 2v5.59a2 2 0 0 0 .59 1.41l9.58 9.59a2 2 0 0 0 2.83 0l5.59-5.59a2 2 0 0 0 0-2.83z"/><circle cx="6.91" cy="7.85" r="1.4" fill="currentColor" stroke="none"/></svg>
          标签池
        </button>
        <button class="admin-side-item" type="button" data-panel="friends">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
          友链
        </button>
        <button class="admin-side-item" type="button" data-panel="media">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
          媒体
        </button>
        <button class="admin-side-item" type="button" data-panel="settings">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-2.9 1.2 2 2 0 1 1-4 0 1.7 1.7 0 0 0-2.9-1.2l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.7 1.7 0 0 0 3 15a2 2 0 1 1 0-4 1.7 1.7 0 0 0 1.5-2.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1A1.7 1.7 0 0 0 10 4a2 2 0 1 1 4 0 1.7 1.7 0 0 0 2.9 1.5l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1A1.7 1.7 0 0 0 21 11a2 2 0 1 1 0 4z"/></svg>
          设置
        </button>
        <button class="admin-side-item" type="button" data-panel="rebuild">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
          构建发布
        </button>
      </aside>

      <section class="admin-main">
        <!-- 文章 -->
        <div class="admin-panel is-active" data-panel-body="posts">
          <div class="admin-toolbar">
            <p class="admin-hint" style="margin:0">共 <b data-post-total>0</b> 篇（含草稿）· 草稿不进构建产物</p>
            <button class="admin-new" type="button" data-action="new-post">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              新建文章
            </button>
          </div>
          <table class="admin-table">
            <thead>
              <tr><th>标题</th><th>分类</th><th>日期</th><th>状态 / 操作</th></tr>
            </thead>
            <tbody data-post-rows></tbody>
          </table>
          <p class="admin-toastline" data-post-msg aria-live="polite"></p>

          <form class="admin-editor" data-editor hidden aria-label="文章编辑" novalidate>
            <h2 data-editor-title>新建文章</h2>
            <div class="admin-field">
              <label for="f-title">标题 <em>必填</em></label>
              <input id="f-title" type="text" placeholder="例如：Beast 的优雅关闭全流程拆解">
            </div>
            <div class="admin-field">
              <label for="f-date">日期</label>
              <input id="f-date" type="date">
            </div>
            <div class="admin-field">
              <label for="f-cat">分类</label>
              <select id="f-cat"></select>
            </div>
            <div class="admin-field">
              <label for="f-tags"><em class="admin-ai-badge">AI 托管</em>标签（逗号分隔，进入全站共享标签池，最多 5 个，留空保存时自动选取）</label>
              <input id="f-tags" type="text" placeholder="留空 = AI 读正文自动选取；或手填如 boost-beast, http">
            </div>
            <div class="admin-field">
              <label for="f-desc"><em class="admin-ai-badge">AI 托管</em>description（列表页与搜索结果使用，≤120 字符，留空自动生成）</label>
              <input id="f-desc" type="text" placeholder="留空 = AI 读正文自动生成一句话摘要">
            </div>
            <div class="admin-field">
              <label for="f-body">正文（Markdown · 支持拖入 .md 文件自动填写）</label>
              <textarea id="f-body" rows="10" placeholder="## 背景&#10;&#10;正文……&#10;&#10;也可以把写好的 .md 文件直接拖进来"></textarea>
            </div>
            <div class="admin-ai-row">
              <button type="button" class="admin-btn admin-btn--ghost admin-btn--ai" data-action="ai-assist">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z"/></svg>
                <span data-ai-label>AI 生成摘要与标签</span>
              </button>
              <span class="admin-ai-note">读完正文自动提炼一句话摘要与最多 5 个标签，只填空字段，生成后仍可手动修改。</span>
            </div>
            <div class="admin-checks">
              <label><input type="checkbox" id="f-featured"> 置顶到面首页</label>
              <label><input type="checkbox" id="f-draft"> 存为草稿（不进入构建产物）</label>
            </div>
            <p class="admin-note">取消「存为草稿」后保存 → 提交进仓库；构建上线后立即可见（提交即发布，无审核环节）。</p>
            <div class="admin-editor-actions">
              <button type="button" class="admin-btn admin-btn--ghost" data-action="cancel-edit">取消</button>
              <button type="button" class="admin-btn admin-btn--primary" data-action="save-post">保存并提交</button>
            </div>
          </form>
        </div>

        <!-- 分类 -->
        <div class="admin-panel" data-panel-body="categories">
          <p class="admin-hint">只维护自己那一面的分类。URL 短名由系统按分类名自动生成（一经发布即冻结）；改名会同步更新该分类下文章的分类字段。</p>
          <div class="admin-toolbar">
            <p class="admin-hint" style="margin:0">共 <b data-cat-total>0</b> 个分类 · 文章编辑里的「分类」下拉与此处同步</p>
            <button class="admin-new" type="button" data-action="new-cat">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              添加分类
            </button>
          </div>
          <div class="admin-cat-list" data-cat-list></div>
          <form class="admin-editor" data-cat-form hidden>
            <h2 data-cat-form-title>新增分类</h2>
            <div class="admin-field">
              <label for="c-name">分类名 <em>必填</em></label>
              <input id="c-name" type="text" placeholder="例如：网络编程">
            </div>
            <div class="admin-field">
              <label for="c-desc">一句话说明</label>
              <input id="c-desc" type="text" placeholder="这个分类收纳什么类型的文章">
            </div>
            <div class="admin-editor-actions">
              <button type="button" class="admin-btn admin-btn--ghost" data-action="cancel-cat">取消编辑</button>
              <button type="button" class="admin-btn admin-btn--primary" data-action="save-cat">保存分类</button>
            </div>
            <p class="admin-toastline" data-cat-msg aria-live="polite"></p>
          </form>
        </div>

        <!-- 标签池：全站共享数据（PRD 3.5 标签共享 · 决策 7.23，两位作者都可维护） -->
        <div class="admin-panel" data-panel-body="tagpool">
          <p class="admin-hint">
            标签池是<strong>全站共享数据</strong>（与友链同类，两位作者都可维护）。
            文章标签已交给 AI 托管（保存文章时自动入池），这里用来<strong>修正 AI 的选择</strong>：
            重命名会同步更新所有文章（新名已存在则并入）；删除会从文章里移除；新增的标签先进池，等下篇文章挂靠。
            变更由服务端一次性提交进仓库（跨面的文章也会同步更新，提交记录里记着是你发起的）。
          </p>
          <div class="admin-toolbar">
            <p class="admin-hint" style="margin:0">共 <b data-tagpool-total>0</b> 个标签 · 括号内为使用它的文章数</p>
            <div class="admin-tagpool-add">
              <input id="tp-new" type="text" placeholder="新标签名，如 grpc" aria-label="新标签名">
              <button class="admin-new" type="button" data-action="add-tag">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                添加
              </button>
            </div>
          </div>
          <table class="admin-table">
            <thead>
              <tr><th>标签</th><th>使用</th><th>操作</th></tr>
            </thead>
            <tbody data-tagpool-rows></tbody>
          </table>
          <p class="admin-toastline" data-tagpool-msg aria-live="polite"></p>
        </div>

        <!-- 友链：站点级共享数据（入口页卡组的数据源，PRD E8 · 决策 7.16） -->
        <div class="admin-panel" data-panel-body="friends">
          <p class="admin-hint">
            友链是<strong>站点级共享数据</strong>（与标签池同类，两位作者都可维护）。
            保存即提交进仓库（<code>src/data/friends.json</code>）；上线请点侧边菜单的「构建发布」按钮，入口页卡组随即更新。
            对外链接一律 <code>rel="noopener"</code> 新窗口打开；友链为外部站点，与本站无关。
          </p>
          <div class="admin-toolbar">
            <p class="admin-hint" style="margin:0">共 <b data-friend-total>0</b> 个友链 · 入口页卡组按此数据发牌</p>
            <button class="admin-new" type="button" data-action="new-friend">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              添加友链
            </button>
          </div>
          <table class="admin-table">
            <thead>
              <tr><th>站点</th><th>地址</th><th>简介</th><th>操作</th></tr>
            </thead>
            <tbody data-friend-rows></tbody>
          </table>
          <p class="admin-toastline" data-friend-msg aria-live="polite"></p>

          <form class="admin-editor" data-friend-editor hidden aria-label="友链编辑" novalidate>
            <h2 data-friend-form-title>添加友链</h2>
            <div class="admin-field-row">
              <div class="admin-field">
                <label for="fl-name">站点名 <em>必填</em></label>
                <input id="fl-name" type="text" placeholder="例如：云端牧码">
              </div>
              <div class="admin-field">
                <label for="fl-url">站点地址 <em>必填</em></label>
                <input id="fl-url" type="text" placeholder="example.com（协议可省略，自动按 https 处理）">
              </div>
            </div>
            <div class="admin-field">
              <label for="fl-avatar">头像图片地址（可选，留空则用站名首字生成）</label>
              <input id="fl-avatar" type="text" placeholder="https://example.com/avatar.png">
            </div>
            <div class="admin-field">
              <label for="fl-desc">一句话简介 <em>必填</em></label>
              <input id="fl-desc" type="text" placeholder="悬停卡片时展示的介绍">
            </div>
            <div class="admin-editor-actions">
              <button type="button" class="admin-btn admin-btn--ghost" data-action="cancel-friend">取消</button>
              <button type="button" class="admin-btn admin-btn--primary" data-action="save-friend">保存友链</button>
            </div>
          </form>
        </div>

        <!-- 媒体 -->
        <div class="admin-panel" data-panel-body="media">
          <p class="admin-hint">
            上传的图片会落到仓库的 <code>public/images/&lt;面&gt;/</code>，构建后可通过
            <code>/images/&lt;面&gt;/文件名</code> 访问。上传后点「复制引用」把 Markdown 图片语法粘进正文即可。
          </p>
          <label class="admin-media-pick">
            <input type="file" accept="image/*" multiple id="media-input" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            选择本地图片（可多选）→ 上传并生成引用
          </label>
          <div class="admin-media-list" data-media-list></div>
        </div>

        <!-- 设置：个人简介 / 在做什么 / 技术栈（存 src/config/author-<面>.json，只能改自己那面） -->
        <div class="admin-panel" data-panel-body="settings">
          <form class="admin-editor" data-bio-editor aria-label="个人设置" novalidate>
            <h2>个人设置</h2>
            <p class="admin-hint" style="margin:0 0 14px">
              展示在自己那一面的侧栏与作者页。保存即提交进仓库（<code data-author-file>src/config/author-.json</code>），
              上线请点侧边菜单的「构建发布」按钮（约 1-2 分钟前台更新），不影响已发布文章。
            </p>
            <div class="admin-field">
              <label for="s-bio">简介文案（<span data-bio-count>0</span> / 200 字，必填）</label>
              <textarea id="s-bio" rows="4" placeholder="一两句话介绍自己写什么、怎么写。例如：写 C++ 后端与网络编程，落笔偏好可复现的细节与可验证的结论。"></textarea>
            </div>
            <div class="admin-field">
              <label for="s-tags">个人标签（逗号分隔，展示在作者页姓名下方，≤ 6 个）</label>
              <input id="s-tags" type="text" placeholder="例如：C++ 后端, 网络编程, 科研复现">
            </div>
            <div class="admin-field">
              <label>在做什么（作者页「在做什么」区块，≤ 8 条，小标题与描述要成对填写）</label>
              <div data-doing-list></div>
              <button type="button" class="admin-btn admin-btn--ghost" data-action="add-doing" style="margin-top:8px">+ 添加一条</button>
            </div>
            <div class="admin-field">
              <label for="s-stack">技术栈（逗号分隔，作者页 chips，≤ 15 个）</label>
              <input id="s-stack" type="text" placeholder="例如：C++17/20, Boost.Asio, NS-3">
            </div>
            <div class="admin-editor-actions" style="justify-content:flex-start">
              <button type="button" class="admin-btn admin-btn--primary" data-action="save-bio">保存以上设置</button>
            </div>
            <p class="admin-toastline" data-bio-msg aria-live="polite"></p>
          </form>
        </div>

        <!-- 构建发布（决策 7.24：服务器端手动触发构建，POST /api/rebuild） -->
        <div class="admin-panel" data-panel-body="rebuild">
          <h2>构建发布</h2>
          <p class="admin-hint" style="margin:0 0 14px">
            把写作台里的最新内容（文章、分类、标签、简介）重新生成为前台页面。
            构建约需 1-2 分钟（通常更快），完成后前台立即生效；<strong>构建失败会保留现有页面</strong>，不会开天窗。
          </p>
          <div class="admin-editor-actions" style="justify-content:flex-start">
            <button type="button" class="admin-btn admin-btn--primary" data-action="site-rebuild">重新构建并发布</button>
          </div>
          <p class="admin-toastline" data-rebuild-msg aria-live="polite"></p>
          <pre class="admin-rebuild-log" data-rebuild-log hidden></pre>
        </div>
      </section>
    </div>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">UU<span class="amp">&amp;</span>Mixt</div>
      <nav class="footer-links" aria-label="站点级链接">
        <a href="/">回到入口页</a>
        <span class="sep">·</span>
        <a href="/about/">关于本站</a>
      </nav>
      <p>UU&amp;Mixt 写作台 · 提交即发布（无审核环节）</p>
    </div>
  </footer>

  </div><!-- /.page-card -->

  <script is:inline src="/scripts/core.js"></script>
  <script is:inline src="/scripts/admin/server.js?v=4"></script>
  <script is:inline src="/scripts/admin/desk.js?v=8"></script>
</body>
</html>

---
/**
 * 文章详情页（[页面与模板]）—— 构建期生成，交互与 demo/post.html 一致：
 * 分类徽章 / 标题 / 作者与日期 / 正文（Markdown + 代码高亮行号复制）/
 * 自动目录（h2/h3）/ 上下篇（限同面）/ Mixt 面合规声明 / 正文方框拖宽。
 */
import { render } from "astro:content";
import Layout from "../../../components/Layout.astro";
import { published, categories, type Face } from "../../../lib/content-layer";
import { charCount, readMinutes, formatWords, formatDate } from "../../../lib/format";
import "../../../styles/reading.css";
import "../../../styles/content-org.css";
import categoriesUU from "../../../config/categories-uu.json";
import categoriesMixt from "../../../config/categories-mixt.json";

export async function getStaticPaths() {
  const faces: Face[] = ["uu", "mixt"];
  const paths = [];
  for (const face of faces) {
    const posts = await published(face);
    for (const post of posts) {
      paths.push({ params: { face, slug: post.data.slug }, props: { post, face } });
    }
  }
  return paths;
}

const { post, face } = Astro.props;
const d = post.data;
const chars = charCount(post.body ?? "");
const AUTHOR = {
  uu: { name: "UU", avatar: "/assets/avatars/uu.jpg", other: "mixt", otherName: "Mixt" },
  mixt: { name: "Mixt", avatar: "/assets/avatars/mixt.jpg", other: "uu", otherName: "UU" },
} as const;
const me = AUTHOR[face as Face];
const other = AUTHOR[me.other as Face];

/* 本面分类配置（空配置面不显示分类标签，PRD 3.5） */
const cats = face === "uu" ? categoriesUU : categoriesMixt;
const showCategory = cats.length > 0 && !!d.category;

/* 上下篇（限同面，与 demo 一致：列表按 featured/日期排序后的相邻项） */
const list = await published(face as Face);
const idx = list.findIndex((p) => p.data.slug === d.slug);
const prev = idx > 0 ? list[idx - 1] : null;
const next = idx >= 0 && idx < list.length - 1 ? list[idx + 1] : null;

/* 同分类推荐（最多 3 篇，排除自身）：上下篇解决「相邻」，同专题才是读者真正想去的下一跳。
   构建期取同面同分类的最新几篇，作者什么都不用做。 */
const related = d.category
  ? list.filter((p) => p.data.slug !== d.slug && p.data.category === d.category).slice(0, 3)
  : [];

/* 目录：从渲染后的正文标题生成（与 demo 的 h2/h3 目录一致） */
const { Content, headings } = await render(post);
/* 分享用的正式地址（面路由） */
const canonical = new URL(`/${face}/posts/${d.slug}/`, Astro.site).href;
/* 社交分享图：取正文第一张图当封面（PWN 文章的截图正是最有辨识度的封面），
   正文无图则由 Layout 回退到 /og-default.jpg */
const ogImage = (post.body ?? "").match(/!\[[^\]]*\]\(\s*([^)\s]+)/)?.[1];
/* og:type=article 需 ISO 时间；frontmatter 的 date 被 Astro 解析为 Date */
const publishedISO = d.date instanceof Date ? d.date.toISOString() : String(d.date ?? "");
---

<Layout
  face={face}
  flipTo={`/${me.other}/`}
  title={`${d.title} · ${me.name} 的文章 · UU&Mixt`}
  description={d.description}
  canonical={canonical}
  ogType="article"
  ogImage={ogImage}
  publishedTime={publishedISO}
  bodyClass="article-page"
  scripts={[
    "/scripts/article-share.js?v=1",
    "/scripts/article-code.js?v=1",
    "/scripts/article-view.js?v=1",
    "/scripts/reading.js?v=1",
  ]}
>
  <Fragment slot="nav">
    <a href={`/${face}/`}>首页</a>
    <a href={`/${face}/writing/`}>归档</a>
    <a href={`/${face}/categories/`}>分类</a>
    <a href={`/${face}/about/`}>关于</a>
  </Fragment>

  <div class="page">
    <div class="article-layout">
      <article>
        <header class="article-header">
          {showCategory && <span class="chip chip--cat">{d.category}</span>}
          <h1>{d.title}</h1>
          <div class="article-meta">
            <span class="author"><img src={me.avatar} alt="" width="26" height="26">{me.name}</span>
            <span class="dot" aria-hidden="true">|</span>
            <time datetime={formatDate(d.date)}>{formatDate(d.date)}</time>
            <span class="dot" aria-hidden="true">|</span>
            <span>{formatWords(chars)} 字 · 约 {readMinutes(chars)} 分钟</span>
            {/* PRD 5.3 分享：移动端优先系统原生分享，桌面端降级为复制链接。
                分享地址是该面的正式路由，接收方直达且不播翻转动画（PRD 4.2 / G2）。 */}
            <button
              class="share-btn"
              type="button"
              data-action="share"
              data-url={canonical}
              data-title={d.title}
              aria-label="分享这篇文章"
              title="分享（复制链接，移动端调用系统分享）"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"/><path d="M12 16V3M8 7l4-4 4 4"/></svg>
              分享
            </button>
          </div>
          {/* 标签：同样的话题要从这里能跳走。此前文章页只有分类徽章，而标签页
              （/uu/tags/…）早就存在，等于有目的地却没有路标。 */}
          {d.tags && d.tags.length > 0 && (
            <div class="article-tags" aria-label="文章标签">
              {d.tags.map((t) => (
                <a href={`/${face}/tags/${encodeURIComponent(t)}/`}>#{t}</a>
              ))}
            </div>
          )}
          {d.updated && +d.updated > +d.date && (
            <p class="updated-note">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
              最后更新于 {formatDate(d.updated)}
            </p>
          )}
        </header>

        {face === "mixt" && (
          <div class="notice notice--warn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
            <span><strong>合规声明：</strong>本文仅用于安全研究与防御，全部实验在自建环境完成；代码为伪代码或已打码，不包含可直接复用的完整利用程序（PRD 3.7）。</span>
          </div>
        )}

        <div class="prose">
          <Content />
        </div>

        <nav class="post-nav" aria-label="上一篇与下一篇">
          {prev ? (
            <a class="prev" href={`/${face}/posts/${prev.data.slug}/`}><span>上一篇</span><b>{prev.data.title}</b></a>
          ) : <span />}
          {next ? (
            <a class="next" href={`/${face}/posts/${next.data.slug}/`}><span>下一篇</span><b>{next.data.title}</b></a>
          ) : <span />}
        </nav>

        {/* 同分类推荐（最多 3 篇）：上下篇只解决「相邻」，同专题才是读者真正想要的下一跳。
            构建期取同面同分类的最新几篇，作者什么都不用做。 */}
        {related.length > 0 && (
          <section class="related" aria-label="同一分类的更多文章">
            <h2 class="related-title">同属「{d.category}」</h2>
            <ul class="related-list">
              {related.map((p) => (
                <li>
                  <a href={`/${face}/posts/${p.data.slug}/`}>
                    <span class="related-name">{p.data.title}</span>
                    <span class="related-meta">{formatDate(p.data.date)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </article>

      {headings.length > 0 && (
        <aside class="toc">
          <div class="toc-head">
            <div class="toc-title">目录</div>
            <button class="toc-toggle" type="button" data-action="toc-toggle" aria-expanded="true" aria-controls="toc-nav">
              <span data-label>收起</span>
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          </div>
          <nav id="toc-nav">
            {headings.filter((h) => h.depth === 2 || h.depth === 3).map((h) => (
              <a href={`#${h.slug}`} class={h.depth === 3 ? "toc-sub" : undefined}>{h.text}</a>
            ))}
          </nav>
        </aside>
      )}
    </div>
  </div>
  {/* 窄屏目录折叠：<860px 默认收起，避免目录把正文挤出视口（2026-10-06 修复 P0）。
      脚本只有几行且与样式同页交付，放在体内避免再发一个请求。 */}
  <script is:inline>
    (function () {
      var toc = document.querySelector(".article-layout .toc");
      var btn = toc && toc.querySelector('[data-action="toc-toggle"]');
      var nav = toc && toc.querySelector("#toc-nav");
      if (!btn || !nav) return;
      var label = btn.querySelector("[data-label]");
      var narrow = function () { return window.matchMedia("(max-width: 860px)").matches; };
      var set = function (open) {
        nav.hidden = !open;
        btn.setAttribute("aria-expanded", String(open));
        if (label) label.textContent = open ? "收起" : "展开";
        toc.classList.toggle("is-collapsed", !open);
      };
      var syncViewport = function () { set(!narrow()); };
      syncViewport();
      btn.addEventListener("click", function () { set(btn.getAttribute("aria-expanded") !== "true"); });
      window.addEventListener("resize", syncViewport);
    })();
  </script>
</Layout>

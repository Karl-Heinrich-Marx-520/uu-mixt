---
/**
 * UU 面首页（与 demo 双栏形态一致：左侧栏 = 作者卡片 + 网站信息；文章主栏带方框拖宽）
 * 数据分工：统计/文章数/总字数 = 构建期静态；运行时间/最后更新 = 构建期默认 + home.js 按访问日刷新。
 */
import Layout from "../../components/Layout.astro";
import Hero from "../../components/Hero.astro";
import PostCard from "../../components/PostCard.astro";
import { published, faceTags, categories } from "../../lib/content-layer";
import { charCount, formatWords, formatDate, daysSince, humanUptime, humanAgo } from "../../lib/format";
import author from "../../config/author-uu.json";

const face = "uu" as const;
const posts = await published(face);
const tagList = await faceTags(face);

/* 侧栏「网站信息」（口径同 demo.js：SITE_START 写死，字数/更新取本面已发布文章） */
const SITE_START = "2026-09-12";
const totalChars = posts.reduce((a, p) => a + charCount(p.body ?? ""), 0);
const latestDate = posts.reduce((a, p) => (p.data.date > a ? p.data.date : a), new Date(0));
const latest = posts.length ? formatDate(latestDate) : "";
const github = "https://github.com/Karl-Heinrich-Marx-520";
---
<Layout
  face="uu"
  flipTo="/mixt/"
  hasHero={true}
  title="UU 的文章 · UU&Mixt"
  description="UU 的一面：C++ 后端、网络编程、源码阅读、科研复现与工程实践的技术笔记。"
  scripts={["/scripts/home.js"]}
>
  <Fragment slot="nav">
    <a href="/uu/" aria-current="page">首页</a>
    <a href="/uu/writing/">归档</a>
    <a href="/uu/categories/">分类</a>
    <a href="/uu/about/">关于</a>
  </Fragment>

  <Hero face="uu" name="UU" tagline="C++ 后端 · 网络编程 · 源码阅读 · 科研复现 · 工程实践" />

  <div class="page home-page" id="content">
    <div class="home-layout">
      <aside class="home-side" aria-label="作者与站点信息">
        <!-- 作者卡片（PRD 4.4 作者身份区） -->
        <section class="side-card author-card">
          <img class="side-avatar" src="/assets/avatars/uu.jpg" alt="UU 的头像" width="88" height="88">
          <h2 class="side-name">UU <span class="face-tag">这一面</span></h2>
          <p class="side-bio">{author.bio}</p>
          <div class="side-stats" aria-label="文章统计">
            <div><b>{posts.length}</b><span>文章</span></div>
            <div><b>{categories(face).length}</b><span>分类</span></div>
            <div><b>{tagList.length}</b><span>标签</span></div>
          </div>
          <a class="follow-btn" href={github} target="_blank" rel="noopener" title="GitHub 关注 UU">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
            Follow Me
          </a>
          <div class="side-social" aria-label="联系方式">
            <a href={github} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
            </a>
            <a href="/uu/rss.xml" aria-label="RSS" title="RSS 订阅 UU 的一面">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.6" fill="currentColor" stroke="none"/></svg>
            </a>
            <a href="#" data-action="copy-mail" data-mail="2632879190@qq.com" data-okmsg="QQ 邮箱已复制：2632879190@qq.com" aria-label="复制 QQ 邮箱" title="点击复制 QQ 邮箱">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </a>
          </div>
        </section>

        <!-- 网站信息卡片 -->
        <section class="side-card site-info">
          <h2 class="side-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="m7 14 4-4 3 3 5-6"/></svg>
            网站信息
          </h2>
          <dl class="site-info-list">
            <div><dt>文章数目</dt><dd>{posts.length} 篇</dd></div>
            <div><dt>运行时间</dt><dd data-si-uptime data-site-start={SITE_START}>{humanUptime(Math.max(1, daysSince(SITE_START)))}</dd></div>
            <div><dt>本站总字数</dt><dd>{formatWords(totalChars)}</dd></div>
            <div><dt>最后更新时间</dt><dd data-si-updated data-latest={latest || undefined}>{latest ? humanAgo(daysSince(latest)) : "—"}</dd></div>
          </dl>
        </section>
      </aside>

      <div class="home-main">
        <div class="home-frame">
          <h2 class="section-title">最新文章</h2>
          <div class="post-list">
            {posts.length === 0 && (
              <div class="empty-state">
                <h2>这一面还没有文章</h2>
                <p>在写作台发布第一篇即可在首页看到。</p>
              </div>
            )}
            {posts.map((post) => <PostCard post={post} face={face} />)}
          </div>
        </div><!-- /.home-frame -->
      </div><!-- /.home-main -->
    </div><!-- /.home-layout -->
  </div>
</Layout>

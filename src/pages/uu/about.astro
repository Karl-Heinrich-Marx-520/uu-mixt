---
/**
 * UU 作者页（[页面与模板]）—— 面导航「关于」
 * 结构按 demo 的 uu-about.html：作者信息 + 在做什么 + 这一面的分类索引 + 技术栈 + 联系。
 */
import Layout from "../../components/Layout.astro";
import { categories, categoryCount, published } from "../../lib/content-layer";
import author from "../../config/author-uu.json";

const face = "uu" as const;
const cats = categories(face);
const posts = await published(face);
const catWithCount = await Promise.all(
  cats.map(async (c) => ({ ...c, count: await categoryCount(face, c.name) }))
);
/* 在做什么 / 技术栈：author-uu.json 为唯一数据源（写作台「设置」维护，决策 7.25）；
   条目为空时整个区块不渲染。 */
---
<Layout
  face="uu"
  flipTo="/mixt/"
  title="关于 UU · UU&Mixt"
  description="UU：C++ 后端与网络编程方向，做异步服务器、Qt 客户端与 AI 集群拥塞控制的科研复现。"
>
  <Fragment slot="nav">
    <a href="/uu/">首页</a>
    <a href="/uu/writing/">归档</a>
    <a href="/uu/categories/">分类</a>
    <a href="/uu/about/" aria-current="page">关于</a>
  </Fragment>

  <section class="author-hero" aria-label="作者信息">
    <img src="/assets/avatars/uu.jpg" alt="UU 的头像">
    <div>
      <h1>UU</h1>
      <p class="author-dir">{author.tags.join(" · ")}</p>
      <p class="author-bio">{author.bio}</p>
    </div>
  </section>

  {author.doing.length > 0 && (
    <section class="author-section">
      <h2>在做什么 <small>共 {posts.length} 篇文章</small></h2>
      <div class="author-facts">
        {author.doing.map((f) => (
          <div class="author-fact">
            <b>{f.t}</b>
            <span>{f.d}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  {catWithCount.length > 0 && (
    <section class="author-section">
      <h2>这一面的分类</h2>
      <div class="author-links">
        {catWithCount.map((c) => (
          <a href={`/uu/categories/#cat-${c.slug}`}>{c.name}（{c.count} 篇）</a>
        ))}
      </div>
    </section>
  )}

  {author.stack.length > 0 && (
    <section class="author-section">
      <h2>技术栈</h2>
      <div class="chip-row">
        {author.stack.map((t) => <span class="chip">{t}</span>)}
      </div>
    </section>
  )}

  <section class="author-section">
    <h2>联系</h2>
    <div class="author-links">
      <a href="https://github.com/Karl-Heinrich-Marx-520" target="_blank" rel="noopener">GitHub</a>
      <a href="/uu/writing/">看 UU 的全部文章</a>
    </div>
    <p style="margin-top:16px"><a class="author-cta" href="/uu/">进入 UU 的一面 →</a></p>
  </section>
</Layout>

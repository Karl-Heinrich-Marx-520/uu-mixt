[Unit]
Description=UU&Mixt 统一小服务（写作台写入 API + 桌宠 LLM 转发）
Documentation=file:///srv/uum/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uum
Group=uum
WorkingDirectory=/srv/uum
ExecStart=/srv/uum/bin/uum-server -config /etc/uum/config.json
# 桌宠上游 Key 不落盘：写进 /etc/uum/pet.env（chmod 600），形如 UUM_LLM_KEY=sk-xxx
EnvironmentFile=-/etc/uum/pet.env
Restart=on-failure
RestartSec=3
MemoryMax=120M

# 加固：只写工作副本与主库，其余只读
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/uum/work /srv/uum/repo.git
PrivateTmp=true

[Install]
WantedBy=multi-user.target

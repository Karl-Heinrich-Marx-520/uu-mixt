[Unit]
Description=UU&Mixt 统一小服务（写作台写入 API + 桌宠 LLM 转发）
Documentation=file:///srv/uum/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uum
Group=uum
WorkingDirectory=/srv/uum
ExecStart=/srv/uum/bin/uum-server -config /etc/uum/config.json
# 桌宠上游 Key 不落盘：写进 /etc/uum/pet.env（chmod 600），形如 UUM_LLM_KEY=sk-xxx
EnvironmentFile=-/etc/uum/pet.env
Restart=on-failure
RestartSec=3
MemoryMax=120M

# 加固：/srv/uum 整树可写（工作副本、主库、dist、锁/日志），其余只读
# （决策 7.24 实测：只放行 work+repo.git 时，uum-rebuild.sh 写锁/日志/dist 全被
#  ProtectSystem=strict 拒绝，脚本毫秒级退出——写作台按钮永远失败）
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/uum
PrivateTmp=true

[Install]
WantedBy=multi-user.target
